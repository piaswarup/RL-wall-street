# Unity cluster settings, read by every script in cluster/.  EDIT THE TWO LINES MARKED "EDIT ME".
#
# Find your PI work directory on Unity with:   ls -d /work/pi_*

# SSH alias for Unity from ~/.ssh/config (see WALKTHROUGH section 2)
UNITY_SSH=unity

# EDIT ME: where the code + Python env live on Unity (fast SSD storage, 1 TB per PI group)
UNITY_DIR=/work/pi_CHANGEME/CHANGEME_USERNAME

# Isaac Lab commit this project was built and tested against (must match your laptop's ~/IsaacLab)
ISAACLAB_REPO=https://github.com/isaac-sim/IsaacLab.git
ISAACLAB_COMMIT=39394453c

# uv version (the project's build backend requires uv < 0.14)
UV_VERSION=0.13.9

# EDIT ME (optional): torch CUDA build. Leave cu130 unless cluster/check_gpu.sbatch reports a driver older than 580,
# then set to cu128 and re-run cluster/setup_unity.sh.
TORCH_CUDA=cu130

TASK=VertigoRl-Wall-Climb-Vertigo-Direct
