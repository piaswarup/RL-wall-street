#usda 1.0
(
    customLayerData = {
        string creator = "URDF USD Converter v0.3.2"
    }
    defaultPrim = "vertigo"
    endTimeCode = 1000000
    kilogramsPerUnit = 1
    metersPerUnit = 1
    startTimeCode = 0
    subLayers = [
        @./physics.usda@
    ]
    upAxis = "Z"
)

over "vertigo"
{
    over "Physics"
    {
        over "wheel_fl" (
            prepend apiSchemas = ["PhysxJointAPI"]
        )
        {
        }

        over "wheel_fr" (
            prepend apiSchemas = ["PhysxJointAPI"]
        )
        {
        }

        over "wheel_rl" (
            prepend apiSchemas = ["PhysxJointAPI"]
        )
        {
        }

        over "wheel_rr" (
            prepend apiSchemas = ["PhysxJointAPI"]
        )
        {
        }

        over "front_tilt" (
            prepend apiSchemas = ["PhysxJointAPI"]
        )
        {
        }

        over "rear_tilt" (
            prepend apiSchemas = ["PhysxJointAPI"]
        )
        {
        }
    }
}

