#usda 1.0
(
    customLayerData = {
        string creator = "URDF USD Converter v0.3.2"
    }
    endTimeCode = 1000000
    kilogramsPerUnit = 1
    metersPerUnit = 1
    startTimeCode = 0
    upAxis = "Z"
)

def Scope "Materials"
{
    def Material "chassis"
    {
        color3f inputs:diffuseColor = (0.01960664, 0.10048152, 0.52252156)
        float inputs:metallic = 0
        float inputs:opacity = 1
        float inputs:roughness = 0.5
        token inputs:wrapMode = "repeat"
        token outputs:displacement (
            displayGroup = "Outputs"
        )
        token outputs:surface (
            displayGroup = "Outputs"
        )
        prepend token outputs:surface.connect = </Materials/chassis/PreviewSurface.outputs:surface>
        token outputs:volume (
            displayGroup = "Outputs"
        )

        def Shader "PreviewSurface" (
            apiSchemas = ["NodeDefAPI"]
        )
        {
            token info:id = "UsdPreviewSurface"
            prepend color3f inputs:diffuseColor.connect = </Materials/chassis.inputs:diffuseColor>
            prepend float inputs:metallic.connect = </Materials/chassis.inputs:metallic>
            prepend float inputs:opacity.connect = </Materials/chassis.inputs:opacity>
            prepend float inputs:roughness.connect = </Materials/chassis.inputs:roughness>
            token outputs:surface
        }
    }

    def Material "tire"
    {
        color3f inputs:diffuseColor = (0.010022825, 0.010022826, 0.010022825)
        float inputs:metallic = 0
        float inputs:opacity = 1
