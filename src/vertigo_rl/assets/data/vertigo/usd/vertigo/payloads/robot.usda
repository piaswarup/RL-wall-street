#usda 1.0
(
    customLayerData = {
        string creator = "URDF USD Converter v0.3.2"
    }
    defaultPrim = "vertigo"
    endTimeCode = 1000000
    kilogramsPerUnit = 1
    metersPerUnit = 1
    startTimeCode = 0
    upAxis = "Z"
)

over "vertigo" (
    prepend apiSchemas = ["IsaacRobotAPI"]
)
{
    custom rel isaac:physics:robotJoints
    custom rel isaac:physics:robotLinks

    over "Physics"
    {
        over "wheel_fl" (
            prepend apiSchemas = ["IsaacJointAPI"]
        )
        {
        }

        over "wheel_fr" (
            prepend apiSchemas = ["IsaacJointAPI"]
        )
        {
        }

        over "wheel_rl" (
            prepend apiSchemas = ["IsaacJointAPI"]
        )
        {
        }

        over "wheel_rr" (
            prepend apiSchemas = ["IsaacJointAPI"]
        )
        {
        }

        over "front_tilt" (
            prepend apiSchemas = ["IsaacJointAPI"]
        )
        {
        }

        over "rear_tilt" (
            prepend apiSchemas = ["IsaacJointAPI"]
        )
        {
        }
    }

    over "Geometry"
    {
        over "base_link" (
            prepend apiSchemas = ["IsaacLinkAPI"]
        )
        {
            over "wheel_fl" (
                prepend apiSchemas = ["IsaacLinkAPI"]
            )
            {
            }

            over "wheel_fr" (
                prepend apiSchemas = ["IsaacLinkAPI"]
            )
            {
            }

            over "wheel_rl" (
                prepend apiSchemas = ["IsaacLinkAPI"]
            )
            {
            }

            over "wheel_rr" (
                prepend apiSchemas = ["IsaacLinkAPI"]
            )
            {
            }

            over "front_prop" (
                prepend apiSchemas = ["IsaacLinkAPI"]
            )
            {
            }

            over "rear_prop" (
                prepend apiSchemas = ["IsaacLinkAPI"]
            )
            {
            }
        }
    }
}

